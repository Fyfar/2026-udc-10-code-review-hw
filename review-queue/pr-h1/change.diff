+import test from "node:test";
+import assert from "node:assert/strict";
+import { createDb } from "../src/db.js";
+import { addBook } from "../src/books.js";
+import { AccessDenied } from "../src/auth.js";
+
+const olya = { id: 1, role: "member" };
+const iryna = { id: 3, role: "librarian" };
+
+test("staff add a book and it gets the next id", () => {
+  const db = createDb();
+  const book = addBook(db, iryna, { title: " Камінний хрест ", author: "Василь Стефаник" });
+  assert.deepEqual(book, { id: 107, title: "Камінний хрест", author: "Василь Стефаник" });
+  assert.equal(db.findBook(107).title, "Камінний хрест");
+});
+
+test("a member cannot add books", () => {
+  assert.throws(() => addBook(createDb(), olya, { title: "X", author: "Y" }), AccessDenied);
+});
