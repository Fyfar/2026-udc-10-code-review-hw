+import { requireRole, STAFF } from "./auth.js";
+
+/** Staff add a book to the catalog. Returns the new catalog entry. */
+export function addBook(db, user, { title, author }) {
+  requireRole(user, STAFF);
+  const book = { id: db.books.at(-1).id + 1, title: title.trim(), author: author.trim() };
+  db.books.push(book);
+  return { id: book.id, title: book.title, author: book.author };
+}
