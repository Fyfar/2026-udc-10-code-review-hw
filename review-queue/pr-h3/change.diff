+/**
+ * Close a loan: staff may return any loan, a member only their own.
+ * Returns the closing fee so the desk can collect it.
+ */
+export function returnLoan(db, user, loanId, onIso) {
+  if (!user) throw new AccessDenied();
+  const loan = db.loans.find((l) => l.id === loanId);
+  if (!loan) throw new Error("no such loan");
+  if (!isStaff(user) && loan.memberId !== user.id) throw new AccessDenied();
+  if (loan.returnedAt !== null) throw new Error("loan is already returned");
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(onIso) || onIso < loan.takenAt) throw new Error("bad return date");
+  loan.returnedAt = onIso;
+  return { loanId: loan.id, returnedAt: onIso, feeKopecks: lateFee(loan, onIso) };
+}
+
